    eos:
      children:
        vms_1:
    servers:
      vars:
        topologies:
          - t1
      children:
        server_1:
    lab:
      hosts:
        vlab-kne-t1-01:
    ptf:
      hosts:
        ptf-kne-t1-01:
          ansible_host: 172.31.101.200
          ansible_user: root
          ansible_password: "{{ lookup('env', 'SONIC_MGMT_PTF_PASSWORD') }}"
    sonic:
      vars:
        mgmt_subnet_mask_length: 24
        ansible_connection: multi_passwd_ssh
        ansible_altpassword: "{{ lookup('env', 'SONIC_MGMT_SONIC_PASSWORD') }}"
        ansible_become: yes
        ansible_remote_tmp: /tmp/.ansible/tmp
      hosts:
        vlab-kne-t1-01:
          ansible_host: 172.31.101.2
          type: kvm
          hwsku: Force10-S6000
          ansible_password: "{{ lookup('env', 'SONIC_MGMT_SONIC_PASSWORD') }}"
          ansible_user: admin

