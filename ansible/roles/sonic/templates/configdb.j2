{% set host = configuration[hostname] %}
{
{% set lag_member_count = dict() %}
    "PORTCHANNEL_MEMBER": {
{% set separator = joiner(",") %}
{% for name, iface in host['interfaces'].items() %}
{% if iface['lacp'] is defined %}
{{ separator() }}
{% if iface['lacp'] in lag_member_count %}
{% set _dummy = lag_member_count.update({ iface['lacp']: lag_member_count[iface['lacp']] + 1 }) %}
{% else %}
{% set _dummy = lag_member_count.update({ iface['lacp']: 1 }) %}
{% endif %}
        "PortChannel{{ iface['lacp'] }}|{{ name }}": {}
{% endif %}
{% endfor %}
    },
    "PORTCHANNEL": {
{% set separator = joiner(",") %}
{% for name, iface in host['interfaces'].items() %}
{% if name.startswith('Port-Channel') %}
{{ separator() }}
        "{{ name | replace("-", "") }}": {
            "admin_status": "up",
            "min_links": {{ (lag_member_count[name | replace("Port-Channel", "") | int] * 0.75) | round(0, 'ceil') | int }},
            "mtu": "9100"
        }
{% endif %}
{% endfor %}
    },
    "INTERFACE": {
{% set separator = joiner(",") %}
{% for name, iface in host['interfaces'].items() %}
{% if not name.startswith('Loopback') and not name.startswith('Port-Channel') and iface['lacp'] is not defined %}
{{ separator() }}
        "{{ name | replace("-", "") }}": {}
{% if iface['ipv4'] is defined %}
{{ separator() }}
        "{{ name | replace("-", "") }}|{{ iface['ipv4'] }}": {}
{% endif %}
{% if iface['ipv6'] is defined %}
{{ separator() }}
        "{{ name | replace("-", "") }}|{{ iface['ipv6'] }}": {}
{% endif %}
{% endif %}
{% endfor %}
{% if host['bp_interface'] is defined %}
{{ separator() }}
        "{{ bp_ifname | replace("-", "") }}": {}
{% if host['bp_interface']['ipv4'] is defined %}
{{ separator() }}
        "{{ bp_ifname | replace("-", "") }}|{{ host['bp_interface']['ipv4'] }}": {}
{% endif %}
{% if host['bp_interface']['ipv6'] is defined %}
{{ separator() }}
        "{{ bp_ifname | replace("-", "") }}|{{ host['bp_interface']['ipv6'] }}": {}
{% endif %}
{% endif %}
    },
{# bgpcfgd and frrcfgd read different CONFIG_DB schemas, so the BGP tables are
   written in the shape of the daemon this neighbour will run. vsonic.yml
   detects the mode from the image's init_cfg.json (vsonic_frr_mgmt_config).
   frrcfgd: vrf-scoped "default|<ip>" keys plus BGP_NEIGHBOR_AF, ROUTE_MAP and
   BGP_GLOBALS rows; it ignores single-key BGP_NEIGHBOR rows and renders no
   `router bgp` without BGP_GLOBALS. bgpcfgd (default when the key is absent):
   the flat single-key shape, unchanged. nhopself is a BGP_NEIGHBOR_AF attribute
   (nhself) in the frrcfgd schema, and rrclient likewise -- the BGP_NEIGHBOR_LIST
   yang has no such leaf, so neither goes on the frrcfgd BGP_NEIGHBOR rows. #}
{% set use_frrcfgd = vsonic_frr_mgmt_config | default(false) | string | lower == 'true' %}
{% set is_confed = host['bgp']['confed_asn'] is defined and host['bgp']['confed_peers'] is defined
      and host['bgp']['confed_asn'] and host['bgp']['confed_peers'] %}
{# Toward the DUT a confederation member is a confed peer, not an eBGP peer, so
   FRR passes the exabgp next-hop through unchanged instead of rewriting it.
   The DUT can only reach that address via its default route and would send
   every route learned here toward its uplinks. Set next-hop-self on the
   DUT-facing sessions, as the cEOS templates (t2-leaf.j2) do. #}
{% set dut_nhself = '1' if is_confed else '0' %}
    "BGP_NEIGHBOR": {
{% set dut_nbrs = [] %}
{% set nbr_af = [] %}
{% set local_ip_addrs = [] %}
{% for name, iface in host['interfaces'].items() %}
{% if not name.startswith('Loopback') and iface['lacp'] is not defined %}
{% if iface['lacp']['ipv4'] is not defined %}
{{ local_ip_addrs.append(iface['ipv4']) }}
{% endif %}
{% if iface['lacp']['ipv4'] is not defined %}
{{ local_ip_addrs.append(iface['ipv6']) }}
{% endif %}
{% endif %}
{% endfor %}
{% for asn, remote_ips in host['bgp']['peers'].items() %}
{% for peer in remote_ips %}
{% set _ = nbr_af.append(peer | lower) %}
{% set _ = dut_nbrs.append(peer | lower) %}
        "{{ 'default|' if use_frrcfgd }}{{ peer | lower }}": {
            "admin_status": "up",
            "asn": "{{ asn }}",
            "holdtime": "10",
            "keepalive": "3",
{% set usable_local_ip_addrs = [] %}
{% for local_ip_addr in local_ip_addrs %}
{% if local_ip_addr | network_in_usable(peer) %}
{{ usable_local_ip_addrs.append(local_ip_addr) }}
{% endif %}
{% endfor %}
            "local_addr": "{{ usable_local_ip_addrs[0].split('/')[0] | lower }}",
            "name": "{{ duts_name }}",
{% if use_frrcfgd %}
            "neighbor": "{{ peer | lower }}",
            "vrf_name": "default"
{% else %}
            "nhopself": "{{ dut_nhself }}",
            "rrclient": "0"
{% endif %}
        },
{% endfor %}
{% endfor %}
{% set _ = nbr_af.append(configuration_properties['common']['nhipv4']) %}
        "{{ 'default|' if use_frrcfgd }}{{ configuration_properties['common']['nhipv4'] }}": {
            "admin_status": "up",
            "asn": "{{ host['bgp']['asn'] }}",
            "holdtime": "10",
            "keepalive": "3",
            "local_addr": "{{ host['bp_interface']['ipv4'].split('/')[0] }}",
            "name": "exabgp",
{% if use_frrcfgd %}
            "neighbor": "{{ configuration_properties['common']['nhipv4'] }}",
            "vrf_name": "default"
{% else %}
            "nhopself": "0",
            "rrclient": "0"
{% endif %}
        },
{% set _ = nbr_af.append(configuration_properties['common']['nhipv6'] | lower) %}
        "{{ 'default|' if use_frrcfgd }}{{ configuration_properties['common']['nhipv6'] | lower }}": {
            "admin_status": "up",
            "asn": "{{ host['bgp']['asn'] }}",
            "holdtime": "10",
            "keepalive": "3",
            "local_addr": "{{ host['bp_interface']['ipv6'].split('/')[0] | lower }}",
            "name": "exabgp",
{% if use_frrcfgd %}
            "neighbor": "{{ configuration_properties['common']['nhipv6'] | lower }}",
            "vrf_name": "default"
{% else %}
            "nhopself": "0",
            "rrclient": "0"
{% endif %}
        }
    },
{# frrcfgd only activates a neighbour through BGP_NEIGHBOR_AF. The route-maps
   are needed because FRR's `bgp ebgp-requires-policy` is on by default and the
   frrcfgd templates do not turn it off, so an eBGP peer without policy would
   establish but exchange no prefixes. #}
{% if use_frrcfgd %}
    "BGP_NEIGHBOR_AF": {
{% set separator = joiner(",") %}
{% for nbr in nbr_af %}
{% set af = 'ipv6_unicast' if ':' in nbr else 'ipv4_unicast' %}
{% set fam = 'V6' if ':' in nbr else 'V4' %}
{{ separator() }}
        "default|{{ nbr }}|{{ af }}": {
            "admin_status": "up",
            "afi_safi": "{{ af }}",
            "neighbor": "{{ nbr }}",
{% if is_confed and nbr in dut_nbrs %}
            "nhself": "true",
{% endif %}
            "route_map_in": ["FROM_BGP_PEER_{{ fam }}"],
            "route_map_out": ["TO_BGP_PEER_{{ fam }}"],
            "vrf_name": "default"
        }
{% endfor %}
    },
{# Permit-all maps referenced above, named like the ones bgpcfgd renders.
   bgpcfgd does not read ROUTE_MAP, so they are inert on that path. #}
    "ROUTE_MAP_SET": {
        "FROM_BGP_PEER_V4": {},
        "TO_BGP_PEER_V4": {},
        "FROM_BGP_PEER_V6": {},
        "TO_BGP_PEER_V6": {}
    },
    "ROUTE_MAP": {
        "FROM_BGP_PEER_V4|10": {"route_operation": "permit"},
        "TO_BGP_PEER_V4|10": {"route_operation": "permit"},
        "FROM_BGP_PEER_V6|10": {"route_operation": "permit"},
        "TO_BGP_PEER_V6|10": {"route_operation": "permit"}
    },
{% endif %}
{# Confederation members get both shapes: BGP_DEVICE_GLOBAL.CONFED for bgpcfgd
   and BGP_GLOBALS confed_id/confed_peers for frrcfgd, matching what
   generate_golden_config_db.py writes for the DUT. #}
{% if is_confed %}
    "BGP_DEVICE_GLOBAL": {
        "CONFED": {
            "asn": "{{ host['bgp']['confed_asn'] }}",
            "peers": "{{ host['bgp']['confed_peers'] | replace(' ', ';') }}"
        }
    },
    "BGP_GLOBALS": {
        "default": {
            "local_asn": "{{ host['bgp']['asn'] }}",
{% if host['interfaces']['Loopback0'] is defined and host['interfaces']['Loopback0']['ipv4'] is defined %}
            "router_id": "{{ host['interfaces']['Loopback0']['ipv4'] | ansible.utils.ipaddr('address') }}",
{% endif %}
            "confed_id": "{{ host['bgp']['confed_asn'] }}",
            "confed_peers": [{% for peer in (host['bgp']['confed_peers'] | string).split() %}{% if not loop.first %}, {% endif %}"{{ peer }}"{% endfor %}]
        }
    },
{% elif use_frrcfgd %}
{# A non-confed neighbour still needs BGP_GLOBALS under frrcfgd, since
   bgpd.conf.db.j2 gates the whole router-bgp block on it. #}
    "BGP_GLOBALS": {
        "default": {
            "local_asn": "{{ host['bgp']['asn'] }}"
{% if host['interfaces']['Loopback0'] is defined and host['interfaces']['Loopback0']['ipv4'] is defined %}
            ,"router_id": "{{ host['interfaces']['Loopback0']['ipv4'] | ansible.utils.ipaddr('address') }}"
{% endif %}
        }
    },
{% endif %}
    "DEVICE_NEIGHBOR_METADATA": {
{% set separator = joiner(",") %}
{% for dut_name in duts_name.split(',') %}
{{ separator() }}
        "{{ dut_name }}": {
                "hwsku": "SONiC-VM",
                "mgmt_addr": "{{ mgmt_ip }}",
                "type": "TorRouter"
        },
        "exabgp": {
                "hwsku": "exabgp",
                "mgmt_addr": "{{ ptf_ip }}",
                "type": "SpineRouter"
        }
{% endfor %}
    },
    "PORTCHANNEL_INTERFACE": {
{% set separator = joiner(",") %}
{% for name, iface in host['interfaces'].items() %}
{% if name.startswith('Port-Channel') %}
{{ separator() }}
        "{{ name | replace("-", "") }}": {}
{% if iface['ipv4'] is defined %}
{{ separator() }}
        "{{ name | replace("-", "") }}|{{ iface['ipv4'] }}": {}
{% endif %}
{% if iface['ipv6'] is defined %}
{{ separator() }}
        "{{ name | replace("-", "") }}|{{ iface['ipv6'] }}": {}
{% endif %}
{% endif %}
{% endfor %}
    },
    "LOOPBACK_INTERFACE": {
{% set separator = joiner(",") %}
{% for name, iface in host['interfaces'].items() %}
{% if name.startswith('Loopback') %}
{{ separator() }}
        "{{ name }}": {}
{% if iface['ipv4'] is defined %}
{{ separator() }}
        "{{ name }}|{{ iface['ipv4'] }}": {}
{% endif %}
{% if iface['ipv6'] is defined %}
{{ separator() }}
        "{{ name }}|{{ iface['ipv6'] }}": {}
{% endif %}
{% endif %}
{% endfor %}
    }
}
