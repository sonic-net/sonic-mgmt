{
  "connection_setup": {{ ("ready_before_warmup" if warmup_seconds else "included_in_first_rpc") | tojson }},
  "execution": {
    "warmup": {{ warmup | tojson }},
    "connection_ready_seconds": {{ connection_ready_seconds | tojson }},
    "mode": {{ ("duration" if duration_seconds else "count") | tojson }},
    "admission_seconds": {{ (duration_seconds if duration_seconds else none) | tojson }},
    "drain_seconds": {{ drain_seconds | tojson }},
    "completed_in_window": {{ (completed_in_window if duration_seconds else none) | tojson }},
    "successful_in_window": {{ (successful_in_window if duration_seconds else none) | tojson }},
    "successful_window_rps": {{ successful_window_rps | tojson }},
    "peak_client_inflight": {{ peak_active | tojson }},
    "workers_with_requests": {{ workers_with_requests | tojson }}
  },
  "bypass_requested": {{ bypass_requested | tojson }},
  "backend_evidence": {},
  "backend_path": {{ ("unverified" if bypass_requested else "native" if operation in ("set", "get-set") else "not_applicable") | tojson }},
  "payload_profile": {{ ("vnet_route_tunnel_batch_v1" if batch_payload else "single_port_description_v1" if operation in ("set", "get-set") else "empty_request_v1") | tojson }},
  "counts": {
    "planned": {{ total | tojson }},
    "started": {{ total | tojson }},
    "completed": {{ completed | tojson }},
    "successful": {{ successful | tojson }},
    "failed": {{ failed | tojson }},
    "unfinished": {{ unfinished | tojson }},
    "attempts": {{ total | tojson }},
    "response_errors": {{ response_errors | tojson }}
  },
  "grpc_status_counts": {{ statuses | tojson }},
  "measurement": {
    "started_ts": {{ started_ts | tojson }},
    "finished_ts": {{ finished_ts | tojson }},
    "elapsed_seconds": {{ elapsed_seconds | tojson }}
  }
}
