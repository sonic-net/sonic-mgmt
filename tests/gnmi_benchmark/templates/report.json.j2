{
  "record_type": "gnmi_benchmark",
  "schema_version": 12,
  "cid": {{ cid | tojson }},
  "marker": {{ marker | tojson }},
  "started_ts": {{ started_ts | tojson }},
  "finished_ts": {{ finished_ts | tojson }},
  "elapsed_seconds": {{ elapsed_seconds | tojson }},
  "device": {{ device | tojson }},
  "benchmark": {
    "client": "grpcio",
    "blaster": {{ blaster | tojson }},
    "profile": {{ profile | tojson }},
    "protocol": "gnmi",
    "connection_type": {{ connection_type | tojson }},
    "auth_mode": "normal",
    "connections": 1,
    "connection_policy": "single_persistent_channel",
    "rpc_timeout_scope": "per_rpc",
    "histogram_profile": "grpc_a66_latency_ms_v1"
  },
  "load": {{ load | tojson }},
  "requests": {{ requests | tojson }},
  "warmup": {{ warmup | tojson }},
  {% if dropped_iterations is not none %}
  "dropped_iterations": {{ dropped_iterations | tojson }},
  {% endif %}
  "resources": {{ resources | tojson }}
}
